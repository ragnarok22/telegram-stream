# Start here: fill in Telegram credentials, channel, and source.
# Obtain user API credentials at https://my.telegram.org/apps (NOT a bot token).
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_CHANNEL=@your_channel

# auto, youtube, hls, file, or web. Set explicit hls for extensionless manifests.
SOURCE_TYPE=auto
SOURCE=https://www.youtube.com/watch?v=YOUR_LIVE_VIDEO_ID
# SOURCE=https://example.com/live/playlist.m3u8
# SOURCE=/media/video.mp4
# For web: SOURCE_TYPE=web, SOURCE=https://your-site.example
# Start with: docker compose --profile web up -d --wait
# The web profile captures video only; browser audio is muted.
WEB_STREAM_URL=http://web:8080/index.m3u8
# Optional page override for previewing the sidecar without changing SOURCE.
WEB_PAGE_URL=
# Raw capture queue, in frames; large queues can retain GiB of shared memory.
WEB_QUEUE_SIZE=16
# Optional lighter capture; defaults to VIDEO_FPS. Output retains VIDEO_FPS.
# WEB_CAPTURE_FPS=15
# 2 preserves high-density rendering; 1 reduces internal capture resolution.
WEB_CAPTURE_SCALE=2
# Opt-in compatible web video copying; other sources still transcode.
WEB_VIDEO_COPY=false

# Local runs only; Compose always overrides this to /data.
DATA_DIR=./data
# Optional. If Telegram rejects RTMP captions, the service retries once without it.
LIVE_STORY_CAPTION=
VIDEO_WIDTH=1280
VIDEO_HEIGHT=720
VIDEO_FPS=30
VIDEO_BITRATE=2500k
AUDIO_BITRATE=128k
ENCODER_PRESET=veryfast
# Bound YouTube input quality before downloading/decoding.
YOUTUBE_MAX_HEIGHT=720
YOUTUBE_MAX_FPS=30

# Docker-only guardrails; increase for demanding sources or larger pages.
STREAMER_CPU_LIMIT=2.0
STREAMER_MEMORY_LIMIT=2g
WEB_CPU_LIMIT=2.0
WEB_MEMORY_LIMIT=2g

TELEGRAM_POLL_INTERVAL=30
RPC_TIMEOUT=15
SOURCE_TIMEOUT=60
STARTUP_TIMEOUT=60
STALL_TIMEOUT=45
RETRY_INITIAL=2
RETRY_MAX=120
SHUTDOWN_TIMEOUT=10

# Only enable after verifying that adopting an unknown active story is intended.
ADOPT_EXISTING_LIVE_STORY=false
# false permits reconciliation/resume after an ordinary container restart.
END_LIVE_STORY_ON_SHUTDOWN=false

# Preferred: `cookies capture --browser firefox --install` manages a private
# /data/youtube-cookies.txt automatically. Leave this empty for managed imports.
# Optional override: a separately mounted, read-only Netscape cookie file.
YOUTUBE_COOKIES_FILE=
# Optional yt-dlp extractor arguments, e.g. externally provisioned PO tokens.
YOUTUBE_EXTRACTOR_ARGS=

# Optional: pin both published Docker images to the same release.
# Without overrides, Compose uses the latest / web aliases from GHCR.
# STREAMER_IMAGE=ghcr.io/ragnarok22/telegram-stream:v0.1.1
# WEB_IMAGE=ghcr.io/ragnarok22/telegram-stream:v0.1.1-web
